{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ielts-writing-coach.dev/schemas/issue-evidence.schema.json",
  "title": "Canonical server-owned IssueEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "essayAttemptId",
    "skillId",
    "startOffset",
    "endOffset",
    "excerpt",
    "diagnosis",
    "categories",
    "hardGrammarError",
    "severity",
    "confidence",
    "adjudicationStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "common.schema.json#/$defs/NonEmptyId" },
    "essayAttemptId": { "$ref": "common.schema.json#/$defs/NonEmptyId" },
    "skillId": { "$ref": "common.schema.json#/$defs/SkillId" },
    "startOffset": { "type": "integer", "minimum": 0 },
    "endOffset": { "type": "integer", "minimum": 1 },
    "excerpt": { "type": "string", "minLength": 1 },
    "diagnosis": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "HARD_GRAMMAR_ERROR",
          "COLLOCATION_NATURALNESS",
          "CHINESE_INFORMATION_ORGANIZATION",
          "LEXICAL_PRECISION",
          "TASK_COVERAGE",
          "ARGUMENT_DEVELOPMENT",
          "COHESION_ORGANIZATION",
          "OPTIONAL_OPTIMIZATION"
        ]
      }
    },
    "hardGrammarError": { "type": "boolean" },
    "severity": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "confidence": { "$ref": "common.schema.json#/$defs/Confidence" },
    "adjudicationStatus": { "enum": ["ACCEPTED", "DISPUTED", "CORRECTED"] }
  }
}
