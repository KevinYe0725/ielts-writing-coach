{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ielts-writing-coach.dev/schemas/exercise-item.schema.json",
  "title": "ExerciseItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "blockId",
    "learningObjectiveId",
    "primarySkillId",
    "stage",
    "itemType",
    "prompt",
    "grading",
    "expectedActiveSeconds",
    "expectedTotalSeconds",
    "isReserve",
    "generationMode",
    "qualityStatus",
    "evidenceOpportunity",
    "contextId",
    "firstAttemptRequired",
    "hintPolicy",
    "feedbackPolicy"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/NonEmptyId" },
    "blockId": { "$ref": "common.schema.json#/$defs/NonEmptyId" },
    "learningObjectiveId": { "$ref": "common.schema.json#/$defs/NonEmptyId" },
    "primarySkillId": { "$ref": "common.schema.json#/$defs/SkillId" },
    "sourceIssueId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/NonEmptyId" },
        { "type": "null" }
      ]
    },
    "stage": {
      "enum": [
        "notice",
        "understand",
        "control",
        "produce",
        "near_transfer",
        "self_check"
      ]
    },
    "itemType": { "$ref": "common.schema.json#/$defs/ExerciseItemType" },
    "prompt": { "type": "string", "minLength": 1 },
    "grading": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "acceptedAnswers", "normalization"],
          "properties": {
            "mode": { "const": "DETERMINISTIC" },
            "acceptedAnswers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "normalization": {
              "enum": ["TRIM_CASE_FOLD", "ORDER_INSENSITIVE", "EXACT"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "minimumConfidence", "criteria"],
          "properties": {
            "mode": { "const": "RUBRIC" },
            "minimumConfidence": {
              "$ref": "common.schema.json#/$defs/Confidence"
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "description", "passingScore"],
                "properties": {
                  "id": { "$ref": "common.schema.json#/$defs/NonEmptyId" },
                  "description": { "type": "string", "minLength": 1 },
                  "passingScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "branchIds"],
          "properties": {
            "mode": { "const": "UNSCORED_BRANCH" },
            "branchIds": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/NonEmptyId" }
            }
          }
        }
      ]
    },
    "expectedActiveSeconds": { "type": "integer", "minimum": 0 },
    "expectedTotalSeconds": { "type": "integer", "minimum": 1 },
    "isReserve": { "type": "boolean" },
    "generationMode": { "enum": ["TEMPLATE", "AI"] },
    "qualityStatus": {
      "enum": ["DRAFT", "VALIDATING", "VALIDATED", "PUBLISHED", "REJECTED"]
    },
    "evidenceOpportunity": {
      "enum": [
        "PRETEST",
        "CONTROLLED_REPAIR",
        "INDEPENDENT_GENERATION",
        "INTEGRATED_APPLICATION",
        "EXIT_TEST",
        "SELF_CHECK",
        "OTHER"
      ]
    },
    "contextId": { "$ref": "common.schema.json#/$defs/NonEmptyId" },
    "firstAttemptRequired": { "type": "boolean" },
    "hintPolicy": { "enum": ["NONE", "ON_REQUEST", "SCAFFOLD_LADDER"] },
    "feedbackPolicy": {
      "enum": ["IMMEDIATE", "BATCH_AFTER_GROUP", "AFTER_SUBMISSION"]
    },
    "independentGroupId": { "$ref": "common.schema.json#/$defs/NonEmptyId" },
    "unseenSurfaceForm": { "type": "boolean" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectiveId", "skillId", "rubric", "passingScore"],
        "properties": {
          "objectiveId": { "$ref": "common.schema.json#/$defs/NonEmptyId" },
          "skillId": { "$ref": "common.schema.json#/$defs/SkillId" },
          "rubric": { "type": "string", "minLength": 1 },
          "passingScore": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
