{
  "name": "ielts-writing-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An open-source, self-hosted IELTS Writing Task 2 learning loop.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "compose:backup": "bash scripts/compose-backup.sh",
    "compose:doctor": "bash scripts/compose-doctor.sh",
    "compose:restore": "bash scripts/compose-restore.sh",
    "compose:upgrade": "bash scripts/compose-upgrade.sh",
    "dev": "pnpm --parallel --filter @iwc/web --filter @iwc/worker dev",
    "run:local": "bash scripts/local-run.sh",
    "run:local:stop": "bash scripts/local-run.sh --stop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:unit": "vitest run",
    "test:recovery-script": "vitest run --config scripts/vitest.config.ts",
    "test:e2e": "playwright test",
    "licenses:check": "node scripts/check-licenses.mjs",
    "security:audit": "pnpm audit --prod --audit-level=moderate",
    "typecheck": "pnpm -r --if-present typecheck && tsc --project scripts/tsconfig.json",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @iwc/db generate",
    "db:migrate": "pnpm --filter @iwc/db migrate",
    "db:seed": "pnpm --filter @iwc/db seed",
    "skill:validate": "python3 scripts/validate_skill.py .agents/skills/coach-ielts-writing",
    "skill:forward": "node scripts/run-skill-forward-tests.mjs",
    "skill:forward:validate": "node scripts/validate-skill-forward-run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
