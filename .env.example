DATABASE_URL=postgresql://iwc:iwc-local-only@127.0.0.1:5433/iwc
APP_URL=http://127.0.0.1:3000
IWC_BIND_ADDRESS=127.0.0.1
IWC_PORT=3000
IWC_POSTGRES_PORT=5433
TRUST_PROXY_HOPS=0
DEPLOYMENT_MODE=personal
# The three direct secret values below are for source development. Docker
# Compose deliberately ignores them and uses its generated iwc_secrets volume.
AUTH_SECRET=
AUTH_SECRET_FILE=
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_FILE=
APP_ENCRYPTION_KEY_VERSION=1
SETUP_TOKEN=
SETUP_TOKEN_FILE=
WORKER_MODE=standalone
WEB_REPLICAS=1
LOG_LEVEL=info
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=
LOCAL_MODEL_BASE_URL_ALLOWLIST=
TELEMETRY_ENABLED=false
